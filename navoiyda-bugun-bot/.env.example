# @BotFather dan olingan token
BOT_TOKEN=123456:ABC

# E'lonlar chiqadigan kanal (bot admin bo'lishi shart). Masalan: -1001234567890
CHANNEL_ID=-1000000000000

# Moderatorlar guruhi (Tasdiqla / Rad / Spam tugmalari shu yerga keladi)
MOD_CHAT_ID=-1000000000000

# Adminlar (vergul bilan): /stats va /broadcast uchun
ADMIN_IDS=111111111,222222222

# Baza. Bo'sh qolsa lokal SQLite (bot.db). Production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=

# Bepul "Ish" / "Ijara" e'loni necha daqiqadan keyin chiqadi (referal bilan darhol)
FREE_DELAY_MINUTES=120
# Darhol chiqish uchun kerak referal soni
FAST_TRACK_REFERRALS=3

# Kunlik digest vaqti (Toshkent vaqti, HH:MM)
DIGEST_TIME=18:00
TIMEZONE=Asia/Tashkent
